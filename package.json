{
  "name": "debug-console-plus",
  "displayName": "Debug Console+",
  "publisher": "Pomisoft",
  "description": "A better debug console with filtering, search, and MCP integration",
  "version": "0.0.11",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Pomis/debug_console_plus.git"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Debuggers"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "panel": [
        {
          "id": "debugConsolePlusContainer",
          "title": "Debug Console+",
          "icon": "$(debug-console)"
        }
      ]
    },
    "views": {
      "debugConsolePlusContainer": [
        {
          "id": "debugConsolePlusView",
          "name": "Debug Console+",
          "type": "webview"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "debugConsolePlus.toggleTimestamps",
          "when": "view == debugConsolePlusView",
          "group": "navigation@1"
        },
        {
          "command": "debugConsolePlus.toggleLogSource",
          "when": "view == debugConsolePlusView",
          "group": "navigation@2"
        },
        {
          "command": "debugConsolePlus.toggleLogLevel",
          "when": "view == debugConsolePlusView",
          "group": "navigation@3"
        },
        {
          "command": "debugConsolePlus.toggleTags",
          "when": "view == debugConsolePlusView",
          "group": "navigation@4"
        },
        {
          "command": "debugConsolePlus.toggleCompact",
          "when": "view == debugConsolePlusView",
          "group": "navigation@5"
        },
        {
          "command": "debugConsolePlus.copyAll",
          "when": "view == debugConsolePlusView",
          "group": "navigation@6"
        },
        {
          "command": "debugConsolePlus.loadLogs",
          "when": "view == debugConsolePlusView",
          "group": "navigation@7"
        },
        {
          "command": "debugConsolePlus.saveLogs",
          "when": "view == debugConsolePlusView",
          "group": "navigation@8"
        },
        {
          "command": "debugConsolePlus.openLogsFolder",
          "when": "view == debugConsolePlusView",
          "group": "navigation@9"
        },
        {
          "command": "debugConsolePlus.setupMcp",
          "when": "view == debugConsolePlusView",
          "group": "navigation@10"
        },
        {
          "command": "debugConsolePlus.clear",
          "when": "view == debugConsolePlusView",
          "group": "navigation@11"
        }
      ]
    },
    "commands": [
      {
        "command": "debugConsolePlus.toggleTags",
        "title": "Toggle syntax highlight",
        "icon": "$(bracket)",
        "category": "Debug Console+"
      },
      {
        "command": "debugConsolePlus.toggleCompact",
        "title": "Compact mode",
        "icon": "$(fold)",
        "category": "Debug Console+"
      },
      {
        "command": "debugConsolePlus.clear",
        "title": "Clear Logs",
        "icon": "$(clear-all)",
        "category": "Debug Console+"
      },
      {
        "command": "debugConsolePlus.copyAll",
        "title": "Copy All Logs",
        "icon": "$(copy)",
        "category": "Debug Console+"
      },
      {
        "command": "debugConsolePlus.toggleTimestamps",
        "title": "Toggle Timestamps",
        "icon": "$(watch)",
        "category": "Debug Console+"
      },
      {
        "command": "debugConsolePlus.toggleLogSource",
        "title": "Toggle Log Source",
        "icon": "$(symbol-namespace)",
        "category": "Debug Console+"
      },
      {
        "command": "debugConsolePlus.toggleLogLevel",
        "title": "Toggle Log Level",
        "icon": "$(symbol-enum)",
        "category": "Debug Console+"
      },
      {
        "command": "debugConsolePlus.focus",
        "title": "Focus Debug Console+"
      },
      {
        "command": "debugConsolePlus.focusFilter",
        "title": "Focus Filter / Search",
        "category": "Debug Console+"
      },
      {
        "command": "debugConsolePlus.diagnose",
        "title": "Diagnose Extension"
      },
      {
        "command": "debugConsolePlus.setupMcp",
        "title": "Set Up MCP Server",
        "icon": "$(plug)",
        "category": "Debug Console+"
      },
      {
        "command": "debugConsolePlus.saveLogs",
        "title": "Save Logs",
        "icon": "$(save)",
        "category": "Debug Console+"
      },
      {
        "command": "debugConsolePlus.loadLogs",
        "title": "Load Logs",
        "icon": "$(folder-opened)",
        "category": "Debug Console+"
      },
      {
        "command": "debugConsolePlus.openLogsFolder",
        "title": "Open Logs Folder",
        "icon": "$(folder)",
        "category": "Debug Console+"
      }
    ],
    "configuration": {
      "title": "Debug Console+",
      "properties": {
        "debugConsolePlus.defaultLevels": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "debug",
              "info",
              "warn",
              "error"
            ]
          },
          "default": [
            "info",
            "warn",
            "error"
          ],
          "description": "Log levels shown by default"
        },
        "debugConsolePlus.maxLogs": {
          "type": "number",
          "default": 10000,
          "description": "Maximum logs per session"
        },
        "debugConsolePlus.showTimestamps": {
          "type": "string",
          "enum": [
            "absolute",
            "elapsed",
            "none"
          ],
          "enumDescriptions": [
            "Time of day (HH:MM:SS.mmm)",
            "Time since the first log of the session (+MM:SS.mmm)",
            "No timestamp column"
          ],
          "default": "absolute",
          "description": "Timestamp column mode. The clock icon cycles through the modes; changing this setting applies it right away."
        },
        "debugConsolePlus.syntaxHighlighting": {
          "type": "boolean",
          "default": true,
          "description": "Highlight [TAGS], JSON and file links in log messages at the start of each session. The title bar toggle changes it for the current session only."
        },
        "debugConsolePlus.compactMode": {
          "type": "boolean",
          "default": false,
          "description": "Start each session in compact mode: strip timestamps, level tags, logcat tags and box-drawing from messages. The title bar toggle changes it for the current session only."
        },
        "debugConsolePlus.showLogSource": {
          "type": "boolean",
          "default": false,
          "description": "Show the log source column: APP (your code), FLUTTER (framework and tooling), PLATFORM (native Android/iOS logs) or DEBUGGER (debug adapter messages)"
        },
        "debugConsolePlus.showLogLevel": {
          "type": "boolean",
          "default": true,
          "description": "Show the log level column (DEBUG, INFO, WARN, ERROR)"
        },
        "debugConsolePlus.colors": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "timestamp": {
              "type": "string",
              "pattern": "^(#[0-9a-fA-F]{3,8})?$",
              "patternErrorMessage": "Use a hex color like #4d5566, or an empty string for the default.",
              "markdownDescription": "Timestamp column. Empty: the log level color."
            },
            "debug": {
              "type": "string",
              "pattern": "^(#[0-9a-fA-F]{3,8})?$",
              "patternErrorMessage": "Use a hex color like #4d5566, or an empty string for the default.",
              "markdownDescription": "Debug rows. Empty: theme `descriptionForeground`."
            },
            "info": {
              "type": "string",
              "pattern": "^(#[0-9a-fA-F]{3,8})?$",
              "patternErrorMessage": "Use a hex color like #4d5566, or an empty string for the default.",
              "markdownDescription": "Info rows. Empty: theme `debugConsole.infoForeground`."
            },
            "warn": {
              "type": "string",
              "pattern": "^(#[0-9a-fA-F]{3,8})?$",
              "patternErrorMessage": "Use a hex color like #4d5566, or an empty string for the default.",
              "markdownDescription": "Warning rows. Empty: theme `debugConsole.warningForeground`."
            },
            "error": {
              "type": "string",
              "pattern": "^(#[0-9a-fA-F]{3,8})?$",
              "patternErrorMessage": "Use a hex color like #4d5566, or an empty string for the default.",
              "markdownDescription": "Error rows. Empty: theme `debugConsole.errorForeground`."
            }
          },
          "default": {
            "timestamp": "",
            "debug": "",
            "info": "",
            "warn": "",
            "error": ""
          },
          "markdownDescription": "Log colors as hex values (e.g. `#4d5566`). A level color applies to the whole row: timestamp, source, level and message. Leave a value empty to use the theme's Debug Console color; leave `timestamp` empty to use the log level color."
        },
        "debugConsolePlus.autoHideTimestampsWidth": {
          "type": "number",
          "default": 200,
          "description": "Auto-hide timestamps when panel width is below this (in pixels)"
        }
      }
    },
    "keybindings": [
      {
        "command": "debugConsolePlus.focusFilter",
        "key": "ctrl+f",
        "mac": "cmd+f",
        "when": "focusedView == 'debugConsolePlusView'"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.74.0",
    "esbuild": "^0.19.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0"
  }
}
